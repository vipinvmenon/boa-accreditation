node_modules/
.next/
out/
dist/
.env
.env.local
.env*.local
.vercel
.DS_Store
*.tsbuildinfo
next-env.d.ts

# Extracted from design/source/boa_design_bundle.html at build time.
# The bundle is the contract; these are derived. See scripts/extract-assets.mjs.
/public/assets/

# Generated by scripts/build-gate-sw.mjs from the real build manifest.
/public/gate/sw.js
/public/gate/zxing_reader.wasm

# Generated by scripts/build-design-reference.mjs.
/design/reference/

# Supabase CLI local state
supabase/.temp/
supabase/.branches/

# Test output
/test-results/
/playwright-report/
/coverage/

# scripts/load-orgs.mjs writes raw invite tokens here. Never commit these —
# see docs/ORG-IMPORT.md, "Do not put raw tokens in git, logs, screenshots,
# the database, or this repository."
/data/*.local.csv

# `vercel link` appends a blanket `.env*`. Keep it — belt and braces over the
# specific rules above — but negate the one env file that IS the contract.
# .env.example carries no values, only the shape, and every new agent needs it.
.env*
!.env.example

# Generated roster workbook artefacts — carry real organisation names and
# rosters (names, phone numbers). Never commit these.
/build/
.playwright-mcp/
