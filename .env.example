# --- Browser-visible. Auth only. ---
# This key holds ZERO table grants and ZERO function EXECUTE. It exists so the
# desk can hold a Supabase session; it cannot read or write a single row.
# Proven by supabase/tests/privileges.test.sql.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=https://accred.bangaloreopenair.com

# --- Server-only. Bypasses RLS. ---
# NEVER give this a NEXT_PUBLIC_ prefix. That would compile it into the client
# bundle and hand every visitor full read/write access to 641 people's phone
# numbers. boa-stok-form's .env.example carries the same warning for the same
# reason; it is repeated here because the mistake is silent and unrecoverable.
SUPABASE_URL=https://YOUR-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated emails permitted to call /api/admin/invite-operator when no
# operator rows exist yet. This is the BOOTSTRAP only — once an operator exists,
# the caller's own boa_acc_operator row is the control, not this list.
BOA_ACC_OPERATOR_BOOTSTRAP=

# Direct Postgres URL for `corepack pnpm test:db`. Local shell / CI secret only.
# Never set in Vercel. See scripts/lib/db-url.mjs.
SUPABASE_DB_URL=
