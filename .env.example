# --- Browser-visible. Auth only. ---
# This key holds ZERO table grants and ZERO function EXECUTE. It exists so the
# desk can hold a Supabase session; it cannot read or write a single row.
# Proven by supabase/tests/privileges.test.sql.
#
# PUBLISHABLE, not the legacy `anon` key: Supabase's current guidance is that
# anon keys exist only for backwards compatibility. This project is new, so it
# starts on the current scheme. (boa-bar-control also uses PUBLISHABLE;
# boa-stok-form still uses ANON_KEY. Do not copy stok's naming.)
NEXT_PUBLIC_SUPABASE_URL=https://tjbfvuboyvaephtewjwq.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=https://accred.bangaloreopenair.com

# --- Server-only. Bypasses RLS. ---
# NEVER give this a NEXT_PUBLIC_ prefix. That would compile it into the client
# bundle and hand every visitor full read/write access to 641 people's phone
# numbers. boa-stok-form's .env.example carries the same warning for the same
# reason; it is repeated here because the mistake is silent and unrecoverable.
SUPABASE_URL=https://tjbfvuboyvaephtewjwq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated emails permitted to call /api/admin/invite-operator without
# an authenticated caller — the trusted bootstrap batch, controlled only by
# this env var (Vercel), never by request input. Inviting anyone NOT on this
# list requires a signed-in caller with an active lead/admin boa_acc_operator
# row instead.
BOA_ACC_OPERATOR_BOOTSTRAP=

# Direct Postgres URL for `corepack pnpm test:db`. Local shell / CI secret only.
# Never set in Vercel. See scripts/lib/db-url.mjs.
SUPABASE_DB_URL=

# --- Server-only. WhatsApp Business Cloud API (ACC-144, docs/WHATSAPP.md). ---
# Set by Vipin in Vercel (ACC-151), never pasted into chat or committed. NONE of
# these may carry a NEXT_PUBLIC_ prefix: the access token sends messages as BOA.
# Unset → /api/desk/passes/send answers "whatsapp_not_configured" and the pass
# sheet falls back to the one-tap wa.me links.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
# Webhook: X-Hub-Signature-256 is an HMAC keyed with the Meta app secret.
WHATSAPP_APP_SECRET=
# Webhook: any long random string; the same value goes in the Meta app's
# webhook "Verify token" field.
WHATSAPP_VERIFY_TOKEN=
# Defaults: boa_crew_pass / en
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=

# --- Server-only. Interakt template send (ADR-024, docs/WHATSAPP.md). ---
# Passes are delivered through Interakt, not Meta's Cloud API — BOA already pays
# for Interakt and Meta's direct path is blocked on a payment method. Set by
# Vipin in Vercel, never pasted into chat or committed. NO NEXT_PUBLIC_ prefix:
# the key sends WhatsApp messages as BOA.
# Unset → the pass sheet falls back to the one-tap wa.me links.
# Settings → Developer Settings → Secret Key, at app.interakt.ai.
INTERAKT_API_KEY=
# The template's CODE NAME (app.interakt.ai/template/<codename>/view), not its
# display name. Defaults: boa_crew_pass / en
INTERAKT_TEMPLATE_NAME=
INTERAKT_TEMPLATE_LANG=
